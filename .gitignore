# Godot 4 project-specific ignores
.godot/
.import/
export.cfg
export_credentials.cfg
*.translation

# Godot-specific exclusions for exported binaries
*.apk
*.aab
*.ipa
*.exe
*.pck

# Android build artifacts (generated by Godot's Android export/gradle build)
android/build/
android/.gradle/
*.keystore
*.jks

# OS / editor cruft
.DS_Store
Thumbs.db
*.tmp
