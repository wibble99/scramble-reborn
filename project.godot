; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scramble Reborn"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

Palette="*res://scripts/autoload/Palette.gd"
PixelArt="*res://scripts/autoload/PixelArt.gd"
Controls="*res://scripts/autoload/Controls.gd"
SFX="*res://scripts/autoload/SFX.gd"
Save="*res://scripts/autoload/Save.gd"
Game="*res://scripts/autoload/Game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="disabled"
window/handheld/orientation="landscape"
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

2d/default_gravity=0
common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
